diff --git a/donkeycar/parts/actuator.py b/donkeycar/parts/actuator.py
index 848feebc..75d090ba 100644
--- a/donkeycar/parts/actuator.py
+++ b/donkeycar/parts/actuator.py
@@ -222,15 +222,48 @@ class VESC:
         self.steering_offset = steering_offset
         self.percent = percent
         
-        try:
-            self.v = pyvesc.VESC(serial_port, has_sensor, start_heartbeat, baudrate, timeout)
-        except Exception as err:
-            print("\n\n\n\n", err)
-            print("\n\nto fix permission denied errors, try running the following command:")
-            print("sudo chmod a+rw {}".format(serial_port), "\n\n\n\n")
-            time.sleep(1)
-            raise
-        
+        # pyvesc decodes a reply as soon as a few bytes arrive, so a reply split
+        # across USB reads fails with "invalid literal for int() with base 10:
+        # 'None'" when it checks the firmware version. Keep reading until a
+        # whole packet decodes. Start the heartbeat only once connected so a
+        # failed attempt doesn't leave a thread running that blocks exit.
+        from pyvesc.protocol.interface import decode
+
+        class _VESC(pyvesc.VESC):
+            def write(self, data, num_read_bytes=None):
+                self.serial_port.write(data)
+                if num_read_bytes is None:
+                    return None
+                buf = b''
+                deadline = time.time() + 0.5
+                while time.time() < deadline:
+                    buf += self.serial_port.read(self.serial_port.in_waiting or 1)
+                    response, consumed = decode(buf)
+                    if response is not None:
+                        return response
+                return None
+
+        retries = 5
+        for attempt in range(1, retries + 1):
+            try:
+                self.v = _VESC(serial_port, has_sensor, False, baudrate, timeout)
+                break
+            except ValueError:
+                print("VESC did not answer cleanly (attempt {}/{}), retrying..."
+                      .format(attempt, retries))
+                time.sleep(0.5)
+            except Exception as err:
+                print("\n\n\n\n", err)
+                print("\n\nto fix permission denied errors, try running the following command:")
+                print("sudo chmod a+rw {}".format(serial_port), "\n\n\n\n")
+                time.sleep(1)
+                raise
+        else:
+            raise RuntimeError("Could not connect to VESC on {}. Is the battery on "
+                               "and USB plugged in?".format(serial_port))
+        if start_heartbeat:
+            self.v.start_heartbeat()
+
     def run(self, angle, throttle):
         self.v.set_servo((angle * self.steering_scale) + self.steering_offset)
         self.v.set_duty_cycle(throttle*self.percent)
